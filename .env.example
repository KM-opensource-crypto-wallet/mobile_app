# Copy to .env for local builds. Values are inlined at bundle time by
# react-native-dotenv; on Codemagic the same names come from the `common`
# environment group (no .env file is created on CI).
DOK_WALLET_BASE_URL=
ATTEST_WORKER_BASE_URL=
REDUX_KEYCHAIN_NAME=
REDUX_SHARED_PREFERENCE_NAME=
REDUX_KEY=
DOKWALLET_WALLET_CONNECT_ID=
KIMLWALLET_WALLET_CONNECT_ID=
DOK_WALLET_GOOGLE_WEB_CLIENT_ID=
KIML_WALLET_GOOGLE_WEB_CLIENT_ID=
WALLET_BACKUP_SECRET=
BREEZ_API_KEY=
DOK_ANDROID_PLAY_INTEGRITY_PROJECT_NUMBER=
DOK_WALLET_ONESIGNAL_APP_ID=
KIML_WALLET_ONESIGNAL_APP_ID=
SPONSOR_TREASURY_ADDRESS_SANDBOX=
SPONSOR_TREASURY_ADDRESS_PRODUCTION=

# Sentry (src/services/logger). One project per variant.
DOK_WALLET_SENTRY_DSN=
KIML_WALLET_SENTRY_DSN=
# Dev only: send events from debug builds (default off) and show the
# "Send Sentry test event" row in Settings.
SENTRY_ENABLE_IN_DEV=
SENTRY_DEV_TOOLS=
# Dev only: print Sentry SDK internals (envelope sends, drops) to Metro.
SENTRY_DEBUG=

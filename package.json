{
  "name": "coinswallet",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npm run clean:watchman && react-native run-android",
    "ios": "npm run clean:watchman && react-native run-ios",
    "lint": "tsc && eslint --fix src --ext .ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "start": "npm run clean:watchman && react-native start --reset-cache",
    "test": "jest",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "clean:ios": "cd ios && rm -rf Pods && cd ..",
    "clean:npm": "rm -rf node_modules && npm cache clean --force && npm install && rm -rf $TMPDIR/metro-cache && rm -rf $TMPDIR/haste-map-*",
    "clean:watchman": "rm -rf ./android/.gradle && watchman watch-del-all",
    "clean:all": "npm run clean:android && npm run clean:ios && npm run clean:watchman && npm run clean:npm",
    "build:android:apk": "npm run build:android:clean && npm run build:android:type:apk",
    "build:android:aab": "npm run build:android:clean && npm run build:android:type:aab",
    "build:android:clean": "rm -rf ./android/.gradle && ./android/gradlew -p ./android clean",
    "build:android:type:apk": "./android/gradlew -p ./android assembleRelease && npm run open:android:build",
    "build:android:type:aab": "./android/gradlew -p ./android bundleRelease && npm run open:android:build",
    "build:ios:ipa": "npm run build:ios:clean && npm run build:ios:archive && npm run build:ios:export",
    "open:android:build": "open ./android/app/build/outputs",
    "open:ios:build": "open ./ios/outputs/SoulVerse",
    "pod:install": "pod install --project-directory=./ios",
    "pod:re-install": "rm -rf ios/Pods && rm -rf ios/.xcode.env.local && npm run pod:install",
    "re-install": "rm -rf node_modules && npm run && npm run pod:re-install",
    "re-install-force": "rm -rf package-lock.json && rm -rf ios/Podfile.lock && npm run re-install",
    "git:update": "git submodule update --init --recursive --remote",
    "postinstall": "npx patch-package && npx rn-nodeify --install assert,url,http,zlib,https,buffer,process,stream,net,crypto --hack"
  },

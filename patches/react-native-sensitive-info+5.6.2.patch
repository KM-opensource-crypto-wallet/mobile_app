+       * Reads a value from the legacy SharedPreferences used by react-native-sensitive-info v5.5.x.
+       * This is used for migrating existing users to the new storage mechanism.
+       */
+      @ReactMethod
+      fun getLegacySecureValue(legacyPrefsName: String, key: String, promise: Promise) {
+        try {
+          val prefs: SharedPreferences = reactApplicationContext.getSharedPreferences(
+            legacyPrefsName,
+            Context.MODE_PRIVATE
+          )
+          val value = prefs.getString(key, null)
+          promise.resolve(value)
+        } catch (e: Exception) {
+          promise.reject("E_LEGACY_READ_ERROR", "Failed to read legacy value: ${e.message}", e)
+        }
+      }

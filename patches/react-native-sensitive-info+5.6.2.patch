+            Context.MODE_PRIVATE
+          )
+          prefs.edit().clear().apply()
+          promise.resolve(null)
+        } catch (e: Exception) {
+          promise.reject("E_LEGACY_CLEAR_ERROR", "Failed to clear legacy storage: ${e.message}", e)

+    out.w3 = ((uint32_t) SBOX[(s3 >> 0) & 0xff] << 0) | ((uint32_t) SBOX[(s0 >> 8) & 0xff] << 8) |
+             ((uint32_t) SBOX[(s1 >> 16) & 0xff] << 16) |
+             ((uint32_t) SBOX[(s2 >> 24) & 0xff] << 24);

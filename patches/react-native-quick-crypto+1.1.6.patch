+    unsigned char tweak_ndx[crypto_ipcrypt_NDX_TWEAKBYTES];
+    unsigned char tweak_ndx2[crypto_ipcrypt_NDX_TWEAKBYTES];
+    unsigned char decrypted[crypto_ipcrypt_BYTES];

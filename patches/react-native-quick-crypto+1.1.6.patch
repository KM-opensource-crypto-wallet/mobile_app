+<!doctype html>
+<html>
+<head>
+<meta name="google" content="notranslate" />
+<style>
+body {
+  background: white;
+  color: black;  
+}
+.test p {
+  margin: 1px;
+}
+.test {
+  font-family: monospace;
+  white-space: pre;   
+}
+.err {
+  background: red;
+  color: white;
+}
+.passed {
+  background: green;
+  color: white; 
+}

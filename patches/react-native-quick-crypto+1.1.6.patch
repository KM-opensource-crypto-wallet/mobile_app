+#define SHUFFLE32x4_2222(x) \
+    vreinterpretq_u64_u32(vdupq_laneq_u32(vreinterpretq_u32_u64(x), 2))
+#define SHUFFLE32x4_3333(x) \
+    vreinterpretq_u64_u32(vdupq_laneq_u32(vreinterpretq_u32_u64(x), 3))
+#define SWAP64HALVES(x) \

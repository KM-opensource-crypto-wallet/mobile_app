+
+  build-apple:
+    runs-on: macos-latest
+    steps:
+      - uses: actions/checkout@v6
+      - name: configure
+        run: ./configure
+      - name: build-xcframework
+        run: env LIBSODIUM_FULL_BUILD=1 LIBSODIUM_SKIP_SIMULATORS=1 dist-build/apple-xcframework.sh
+      - uses: actions/upload-artifact@v7

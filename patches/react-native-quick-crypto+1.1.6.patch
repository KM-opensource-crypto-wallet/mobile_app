+    key   = (unsigned char *) sodium_malloc(crypto_aead_aegis128l_KEYBYTES);
+    nonce = (unsigned char *) sodium_malloc(crypto_aead_aegis128l_NPUBBYTES);
+    mac   = (unsigned char *) sodium_malloc(crypto_aead_aegis128l_ABYTES);

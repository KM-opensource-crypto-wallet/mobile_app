+inv_mix_column(uint32_t col)
+{
+    uint8_t b0 = (uint8_t) col;
+    uint8_t b1 = (uint8_t) (col >> 8);
+    uint8_t b2 = (uint8_t) (col >> 16);
+    uint8_t b3 = (uint8_t) (col >> 24);

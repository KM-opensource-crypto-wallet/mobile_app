+    /* Test one-shot API */
+    for (i = 0; i < sizeof(vectors) / sizeof(vectors[0]); i++) {
+        crypto_xof_turboshake256(out, vectors[i].out_len, vectors[i].msg, vectors[i].msg_len);
+        if (memcmp(out, vectors[i].out, vectors[i].out_len) != 0) {

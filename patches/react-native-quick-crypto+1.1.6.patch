diff --git a/node_modules/react-native-quick-crypto/ios/libsodium-stable/builds/msvc/vs2010/libsodium.import.props b/node_modules/react-native-quick-crypto/ios/libsodium-stable/builds/msvc/vs2010/libsodium.import.props

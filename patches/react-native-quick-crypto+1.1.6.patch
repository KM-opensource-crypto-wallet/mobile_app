+    do {
+        assert(strlen(tests[i].key_hex) == 2 * crypto_aead_aegis128l_KEYBYTES);
+        sodium_hex2bin(key, crypto_aead_aegis128l_KEYBYTES, tests[i].key_hex,
+                       strlen(tests[i].key_hex), NULL, NULL, NULL);

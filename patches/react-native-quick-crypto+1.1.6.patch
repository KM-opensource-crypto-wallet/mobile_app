+          cd zig-out/bin && env LD_LIBRARY_PATH=/usr/arm-linux-gnueabihf/lib ./run.sh
+      - uses: actions/upload-artifact@v7
+        with:
+          name: build-linux-arm
+          path: zig-out/lib/libsodium.so
+
+      - name: build-linux-arm64
+        run: |

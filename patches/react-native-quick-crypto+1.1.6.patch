+            printf("Test vector %zu failed (one-shot)\n", i);
+            return 1;
+        }
+    }
+
+    /* Test streaming API */
+    for (i = 0; i < sizeof(vectors) / sizeof(vectors[0]); i++) {
+        crypto_xof_shake256_init(&state);
